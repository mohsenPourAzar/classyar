# Local MongoDB; for Atlas, replace with your own mongodb+srv connection string.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=classyar
# Next.js website port; keep MongoDB's port (normally 27017) in MONGODB_URI.
PORT=4173
# Server-only Google Gemini key. Never use NEXT_PUBLIC_ for credentials.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_LIVE_MODEL=gemini-3.8-live
